@*projectsが、List<ProjectViewModel>型のため型が一致している必要がある*@
@model List<TaskManager.Models.ViewModels.ProjectViewModel>

@{
	ViewData["Title"] = "プロジェクト一覧";
}

<h2>プロジェクト一覧</h2>

<p>
	<a asp-action="Create" class="btn btn-primary">新規プロジェクト作成</a>
</p>

@*.Any()はLINQのメソッドで、「1件でも要素が存在するか」をtrue/falseで返す*@
@if (!Model.Any())
{
	<p>まだプロジェクトがありません。</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>プロジェクト名</th>
				<th>説明</th>
				<th>タスク数</th>
				<th>作成日</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var project in Model)
			{
				<tr>
					<td>@project.Name</td>
					<td>@project.Description</td>
					<td>@project.TaskCount</td>
					<td>@project.CreatedAt.ToString("yyyy/MM/dd")</td>
					<td>
						@*asp-route-id:URLの一部としてパラメータ(ID)を渡す必要がある時に用いる*@
						@*例えばproject.Idが3だった場合、以下のようなURLが自動生成される*@
						@*/Project/Edit/3*@
						<a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-secondary">編集</a>
						<a asp-action="Delete" asp-route-id="@project.Id" class="btn btn-sm btn-danger">削除</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}