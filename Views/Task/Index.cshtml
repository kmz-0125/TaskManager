@model List<TaskManager.Models.ViewModels.TaskViewModel>
@using TaskManager.Extensions

@{
	ViewData["Title"] = "タスク一覧";
}

<h2>@ViewBag.ProjectName のタスク一覧</h2>

<p>
	<a asp-action="Create" asp-route-projectId="@ViewBag.ProjectId" class="btn btn-primary">新規タスク作成</a>
	<a asp-controller="Project" asp-action="Index" class="btn btn-secondary">プロジェクト一覧に戻る</a>
</p>

@if (!Model.Any())
{
	<p>まだタスクがありません。</p>
}
else
{
	<table class="table">
		<thead>
			<tr>
				<th>タスク名</th>
				<th>ステータス</th>
				<th>優先度</th>
				<th>期限</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var task in Model)
			{
				<tr>
					<td>@task.Title</td>
					<td>@task.Status.GetDisplayName()</td>
					<td>@task.Priority.GetDisplayName()</td>
					@*DueDateが設定されている場合 → "2026/09/15"と表示 DueDateが設定されていない場合(null) → "未設定"と表示*@
					<td>@(task.DueDate?.ToJstString("yyyy/MM/dd") ?? "未設定")</td>
					<td>
						<a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-secondary">編集</a>
						<a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-sm btn-danger">削除</a>
						@*System.Threading.Tasks.TaskStatusという標準クラスと名前が衝突するリスクがあるため、TaskManager.Models.TaskStatusと完全に書く方法がよい*@
						@if (task.Status != TaskManager.Models.TaskStatus.Completed)
						{
							<form asp-action="ChangeStatus" asp-route-id="@task.Id" method="post" class="d-inline">
								<button type="submit" class="btn btn-sm btn-danger">ステータス変更</button>
							</form>
						}
						<a asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-secondary">詳細</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
}